{
  "name": "alquilertorremolinos-monorepo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=@alquiler/web",
    "build": "npm run build --workspace=@alquiler/web",
    "preview": "npm run preview --workspace=@alquiler/web",
    "test:i18n": "npm run test:i18n --workspace=@alquiler/web",
    "build:packages": "npm run build --workspace=@alquiler/domain && npm run build --workspace=@alquiler/beds24",
    "build:all": "npm run build:packages && npm run build",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "beds24:cli": "npm run cli --workspace=@alquiler/beds24 --"
  },
  "devDependencies": {
    "typescript": "~5.9.3"
  }
}
